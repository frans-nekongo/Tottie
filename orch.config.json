{
  "name": "Tottie",
  "description": "Self-curating agent memory over MCP — memory engine + Tottie UI",
  "versions": {
    "Tottie Full Stack": [
      {
        "name": "CORE",
        "command": "./venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8765",
        "cwd": "./core",
        "color": "green",
        "ports": [8765],
        "env": {
          "TOTTIE_PORT": "8765",
          "TOTTIE_OWNER": "owner_local",
          "TOTTIE_API_TOKEN": "changeme-local-token",
          "TOTTIE_UI_ORIGIN": "http://127.0.0.1:3055",
          "TOTTIE_PROVIDER": "auto",
          "TOTTIE_DB_URL": "postgresql://localhost:5432/tottie",
          "TOTTIE_EMBEDDER": "fastembed",
          "TOTTIE_EMBED_MODEL": "BAAI/bge-small-en-v1.5",
          "EMBEDDING_CACHE_DIR": "../../local LLMS",
          "LOCAL_LLM_URL": "http://127.0.0.1:11434",
          "LOCAL_LLM_MODEL": "nkngo-qwen-coder-3b",
          "LOCAL_LLM_MAX_CTX": "4096",
          "LOCAL_LLM_MAX_TOKENS": "512",
          "META_API_KEY": "",
          "META_BASE_URL": "https://api.meta.ai/v1",
          "META_MODEL": "muse-spark-1.3-contributor",
          "TOTTIE_IDENTITY_SALIENCE": "0.90",
          "TOTTIE_RECONCILE_COSINE": "0.86",
          "TOTTIE_ACTIVE_COSINE": "0.60",
          "TOTTIE_RECALL_K": "8",
          "TOTTIE_SURPRISE_FLOOR": "0.25",
          "TOTTIE_UTILITY_HALF_LIFE_DAYS": "30",
          "TOTTIE_CONFIDENCE_FLOOR": "0.35",
          "TOTTIE_RIF_ENABLED": "0",
          "TOTTIE_HNSW_EF_SEARCH": "100",
          "TOTTIE_INLINE_WRITE": "0",
          "TOTTIE_REPLAY_N": "50",
          "TOTTIE_RATE_LIMIT_PER_MIN": "60",
          "TOTTIE_MAX_ROWS_PER_DAY": "2000"
        }
      },
      {
        "name": "UI",
        "command": "npm run dev",
        "cwd": "./ui",
        "color": "blue",
        "ports": [3055],
        "env": {
          "NEXT_PUBLIC_TOTTIE_CORE_URL": "http://127.0.0.1:8765",
          "NEXT_PUBLIC_TOTTIE_OWNER": "owner_local",
          "TOTTIE_CORE_URL": "http://127.0.0.1:8765",
          "TOTTIE_API_TOKEN": "changeme-local-token",
          "TOTTIE_OWNER": "owner_local"
        }
      }
    ],
    "Core Only": [
      {
        "name": "CORE",
        "command": "./venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8765 --reload",
        "cwd": "./core",
        "color": "green",
        "ports": [8765],
        "env": {
          "TOTTIE_PORT": "8765",
          "TOTTIE_API_TOKEN": "changeme-local-token",
          "TOTTIE_DB_URL": "postgresql://localhost:5432/tottie",
          "TOTTIE_EMBEDDER": "fastembed",
          "EMBEDDING_CACHE_DIR": "../../local LLMS",
          "TOTTIE_PROVIDER": "auto",
          "TOTTIE_SURPRISE_FLOOR": "0.25",
          "TOTTIE_UTILITY_HALF_LIFE_DAYS": "30",
          "TOTTIE_CONFIDENCE_FLOOR": "0.35",
          "TOTTIE_RIF_ENABLED": "0",
          "TOTTIE_HNSW_EF_SEARCH": "100",
          "TOTTIE_INLINE_WRITE": "0",
          "TOTTIE_REPLAY_N": "50",
          "TOTTIE_RATE_LIMIT_PER_MIN": "60",
          "TOTTIE_MAX_ROWS_PER_DAY": "2000"
        }
      }
    ],
    "Tottie + Local LLM": [
      {
        "name": "CORE",
        "command": "./venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8765",
        "cwd": "./core",
        "color": "green",
        "ports": [8765],
        "env": {
          "TOTTIE_PORT": "8765",
          "TOTTIE_API_TOKEN": "changeme-local-token",
          "TOTTIE_DB_URL": "postgresql://localhost:5432/tottie",
          "LOCAL_LLM_URL": "http://127.0.0.1:11434",
          "TOTTIE_PROVIDER": "auto",
          "TOTTIE_SURPRISE_FLOOR": "0.25",
          "TOTTIE_UTILITY_HALF_LIFE_DAYS": "30",
          "TOTTIE_CONFIDENCE_FLOOR": "0.35",
          "TOTTIE_RIF_ENABLED": "0",
          "TOTTIE_HNSW_EF_SEARCH": "100",
          "TOTTIE_INLINE_WRITE": "0",
          "TOTTIE_REPLAY_N": "50",
          "TOTTIE_RATE_LIMIT_PER_MIN": "60",
          "TOTTIE_MAX_ROWS_PER_DAY": "2000"
        }
      },
      {
        "name": "UI",
        "command": "npm run dev",
        "cwd": "./ui",
        "color": "blue",
        "ports": [3055],
        "env": {
          "NEXT_PUBLIC_TOTTIE_CORE_URL": "http://127.0.0.1:8765",
          "TOTTIE_CORE_URL": "http://127.0.0.1:8765",
          "TOTTIE_API_TOKEN": "changeme-local-token",
          "TOTTIE_OWNER": "owner_local"
        }
      }
    ]
  },
  "tests": {
    "command": "python3",
    "args": ["-m", "pytest", "tests", "-q"],
    "cwd": "./core"
  }
}
