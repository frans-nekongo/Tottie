# ============================================================
# Tottie — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Every variable here is also wired into orch.config.json (Mandate #16).
# ============================================================

# ---- memory engine (core/) ----
TOTTIE_PORT=8765
TOTTIE_OWNER=owner_local
# Postgres + pgvector (documented exception to the SQLite-local rule)
TOTTIE_DB_URL=postgresql://localhost:5432/tottie

# ---- embeddings ----
# fastembed (real) | hash (dev-only smoke-test fallback, clearly not production)
TOTTIE_EMBEDDER=fastembed
TOTTIE_EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR="../../local LLMS"

# ---- model providers (Meta primary, local fallback) ----
# Meta Model API (Muse Spark series). Fill the base URL + model IDs once credits land.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3-contributor
# Local fallback (Ollama / llama.cpp, OpenAI-compatible)
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=nkngo-qwen-coder-3b
LOCAL_LLM_MAX_CTX=4096
LOCAL_LLM_MAX_TOKENS=512

# ---- auth (every route except /health; also in orch.config.json) ----
TOTTIE_API_TOKEN=changeme-local-token
TOTTIE_UI_ORIGIN=http://127.0.0.1:3055
# auto = meta if healthy else local. Flip meta|local with no restart.
TOTTIE_PROVIDER=auto

# ---- curation tuning (initial values; calibrate against the eval harness) ----
TOTTIE_IDENTITY_SALIENCE=0.90
TOTTIE_RECONCILE_COSINE=0.86
TOTTIE_ACTIVE_COSINE=0.60
TOTTIE_RECALL_K=8
TOTTIE_FAMILIARITY_COSINE=0.80
TOTTIE_UTILITY_HALF_LIFE_DAYS=30
TOTTIE_CONFIDENCE_FLOOR=0.35
TOTTIE_RIF_ENABLED=0
TOTTIE_NLI_ENABLED=1
TOTTIE_NLI_THRESHOLD=0.70
# TOTTIE_NLI_DIR overrides the NLI weights dir (default: <EMBEDDING_CACHE_DIR>/nli-deberta-v3-small)
TOTTIE_HNSW_EF_SEARCH=100

# ---- write path ----
# TOTTIE_INLINE_WRITE=1 runs curation inline (single-worker demo fallback, no queue)
TOTTIE_INLINE_WRITE=0

# ---- prospective ----
TOTTIE_REPLAY_N=50

# ---- sleep (consolidation) ----
TOTTIE_SLEEP_WINDOW_DAYS=7
TOTTIE_SLEEP_REPLAY_CAP=50
TOTTIE_SLEEP_RANK_SALIENCE=0.6

# ---- rate limits ----
TOTTIE_RATE_LIMIT_PER_MIN=60
TOTTIE_MAX_ROWS_PER_DAY=2000

# ---- MCP ----
TOTTIE_MCP_TRANSPORT=stdio
# optional (Stretch; deprecated in 2026-07-28 spec — keep off by default)
TOTTIE_USE_SAMPLING=0

# ---- Tottie UI (ui/) ----
NEXT_PUBLIC_TOTTIE_CORE_URL=http://127.0.0.1:8765
NEXT_PUBLIC_TOTTIE_OWNER=owner_local
