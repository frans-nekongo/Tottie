# ============================================================
# Tottie — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Every variable here is also wired into orch.config.json (Mandate #16).
# ============================================================

# ---- memory engine (core/) ----
TOTTIE_PORT=8765
TOTTIE_OWNER=owner_local
# Postgres + pgvector (documented exception to the SQLite-local rule)
TOTTIE_DB_URL=postgresql://localhost:5432/tottie

# ---- embeddings ----
# fastembed (real) | hash (dev-only smoke-test fallback, clearly not production)
TOTTIE_EMBEDDER=fastembed
TOTTIE_EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=../../local LLMS

# ---- model providers (Meta primary, local fallback) ----
# Meta Model API (Muse Spark series). Fill the base URL + model IDs once credits land.
META_API_KEY=
META_BASE_URL=
META_MODEL=
# Local fallback (Ollama / llama.cpp, OpenAI-compatible)
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=nkngo-qwen-coder-3b
LOCAL_LLM_MAX_CTX=4096
LOCAL_LLM_MAX_TOKENS=512

# ---- curation tuning ----
TOTTIE_IDENTITY_SALIENCE=0.90
TOTTIE_RECONCILE_COSINE=0.86
TOTTIE_RECALL_K=8

# ---- MCP ----
TOTTIE_MCP_TRANSPORT=stdio
# optional (Stretch; deprecated in 2026-07-28 spec — keep off by default)
TOTTIE_USE_SAMPLING=0

# ---- Tottie UI (ui/) ----
NEXT_PUBLIC_TOTTIE_CORE_URL=http://127.0.0.1:8765
NEXT_PUBLIC_TOTTIE_OWNER=owner_local
